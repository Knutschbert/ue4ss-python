{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "copyName",
      "type": "promptString",
      "description": "Name for the kept copy in scripts/user (empty = keep no copy)",
      "default": ""
    },
    {
      "id": "gamePath",
      "type": "promptString",
      "description": "The game's folder, its Binaries\\Win64 folder, or its executable",
      "default": ""
    }
  ],
  "tasks": [
    {
      "label": "Deploy current script to the game",
      "detail": "Compile-check the open file, install it as main.py, keep a named copy. Reload it in the game with the key bound to ue4ss.reload.",
      "type": "shell",
      "command": "where py >nul 2>&1 & if errorlevel 1 (python \"${workspaceFolder}\\tools\\deploy_script.py\" \"${file}\" --name \"${input:copyName}\") else (py -3 \"${workspaceFolder}\\tools\\deploy_script.py\" \"${file}\" --name \"${input:copyName}\")",
      "options": { "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] } },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Install: choose the game (first time)",
      "detail": "Build UE4SS, the proxy and the mod, package, and install into the game you name. The game is remembered in local.config.json.",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/tools/install.py", "--game", "${input:gamePath}"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Install: build and install into the game",
      "detail": "Build everything, package, and install into the remembered game.",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/tools/install.py"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Install: package and install without building",
      "detail": "For changes to Python files only (python/lib, your scripts).",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/tools/install.py", "--skip-build"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Build: mod (main.dll)",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Build: UE4SS.dll",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1", "-Target", "UE4SS"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Build: proxy (dwmapi.dll)",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1", "-Target", "proxy"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Package the mod (dist/PythonScripting)",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/tools/package_mod.py", "--main-dll", "build/src/main.dll", "--runtime-dir", "third_party/python/runtime", "--out-dir", "dist"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Game: start",
      "detail": "Start the remembered game, unless it already runs.",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/tools/start_game.py"],
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Game: follow the Python output",
      "detail": "Shows the [Python] lines of the game's UE4SS.log as they appear. Stop with Ctrl+C.",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/tools/follow_log.py"],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test: Python tests",
      "type": "process",
      "command": "python",
      "args": ["-m", "pytest", "python/tests", "tools", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test: C++ host tests of core/ (through WSL)",
      "detail": "Needs WSL with clang++; on Linux run tools/run_host_tests.sh directly.",
      "type": "process",
      "command": "wsl.exe",
      "args": ["bash", "tools/run_host_tests.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Typings: regenerate the shipped base typings",
      "detail": "Rewrites python/typings/ue4ss from the off-game module (after an API change).",
      "type": "process",
      "command": "python",
      "args": ["-I", "${workspaceFolder}/tools/gen_base_stubs.py"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}
